# Copy to deploy.env and fill in. deploy.env is not tracked by git.
DEPLOY_SSH="ssh -i ~/.ssh/your-key -o IdentitiesOnly=yes root@192.0.2.10"
DEPLOY_HOST=192.0.2.10          # LAN/VPN address of the Docker host
API_PORT=8097
MOTIS_PORT=8098
DATA=/mnt/user/appdata/takt
MOTIS_VERSION=2.11
REQUIRE_TOKEN=true              # refuse to start without a token in DATA/tokens.txt (needed when public)
